<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Runtime Notification Permission (Android 13 / API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground Service Permissions for Autonomous Countdown Engine (Android 14 / API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".NotiEngineApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotiEngine">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NotiEngine"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Autonomous Timer ForegroundService compliant with Android 14+ (API 34/35) -->
        <service
            android:name=".service.TimerForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Autonomous notification countdown and progress tracker triggered via user automation BroadcastIntents" />
        </service>

        <!-- Incoming IPC BroadcastReceiver from MacroDroid & Automation Tools -->
        <receiver
            android:name=".receiver.NotiReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.notiforge.action.SHOW" />
                <action android:name="com.notiforge.action.SHOW_NOTIFICATION" />
                <action android:name="com.notiforge.action.UPDATE" />
                <action android:name="com.notiforge.action.CANCEL" />
            </intent-filter>
        </receiver>

        <!-- Internal Notification Action Button, RemoteInput & Swipe-to-Dismiss PendingIntent Receiver -->
        <receiver
            android:name=".receiver.NotiActionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.notiforge.action.INTERNAL_BUTTON_CLICK" />
                <action android:name="com.notiforge.action.INTERNAL_REMOTE_INPUT" />
                <action android:name="com.notiforge.action.INTERNAL_NOTIFICATION_DISMISSED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
