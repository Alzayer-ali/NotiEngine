<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/noti_header_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/noti_header_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/noti_icon_content_desc"
        android:src="@drawable/ic_noti_default" />

    <TextView
        android:id="@+id/noti_status_badge"
        style="@android:style/TextAppearance.Material.Notification.Info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_noti_status_pill"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textAllCaps="true"
        android:textColor="@color/noti_badge_text"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/noti_progress_text"
        style="@android:style/TextAppearance.Material.Notification.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textColor="@color/noti_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
