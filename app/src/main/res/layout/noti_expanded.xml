<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/noti_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- 1. HEADER BLOCK: Status Badge + Accent Icon + Live Timer/Percentage Readout -->
    <LinearLayout
        android:id="@+id/noti_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/noti_header_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/noti_icon_content_desc"
            android:src="@drawable/ic_noti_default" />

        <TextView
            android:id="@+id/noti_status_badge"
            style="@android:style/TextAppearance.Material.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_noti_status_pill"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textAllCaps="true"
            android:textColor="@color/noti_badge_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/noti_progress_text"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/noti_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2. HEADLINE & BODY -->
    <TextView
        android:id="@+id/noti_title"
        style="@android:style/TextAppearance.Material.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/noti_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/noti_body"
        style="@android:style/TextAppearance.Material.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/noti_text_secondary"
        android:textSize="13sp" />

    <!-- 3. PROGRESS BLOCK -->
    <LinearLayout
        android:id="@+id/noti_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/noti_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/noti_progress_horizontal" />
    </LinearLayout>

    <!-- 4. DETAIL / METADATA & REPLY STATUS BLOCK -->
    <LinearLayout
        android:id="@+id/noti_detail_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_noti_detail_box"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/noti_metadata"
            style="@android:style/TextAppearance.Material.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/noti_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/noti_reply_status"
            style="@android:style/TextAppearance.Material.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/noti_text_primary"
            android:textSize="11sp"
            android:textStyle="italic"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 5. ACTION BUTTONS BLOCK (Up to 3 Custom Pill Buttons) -->
    <LinearLayout
        android:id="@+id/noti_actions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/noti_btn_1"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_noti_action_btn"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/noti_button_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/noti_btn_2"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_noti_action_btn"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/noti_button_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/noti_btn_3"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_noti_action_btn"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/noti_button_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
